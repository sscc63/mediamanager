# 用户配置
## 123账号（或open开放平台账号）
ENV_123_CLIENT_ID=
## 必填：123密码（或open开放平台密码）
ENV_123_CLIENT_SECRET=
## Telegram Bot Token（从 @BotFather 获取，留空则不启用 TG 通知/命令）
ENV_TG_BOT_TOKEN=
## Telegram 管理员用户ID（从 @userinfobot 获取，多个用英文逗号分隔）
ENV_TG_ADMIN_USER_ID=
## 夸克网盘 Cookie（用于转存夸克分享，浏览器 F12 抓包获取）
ENV_KUAKE_COOKIE=
## TMDB API Key（themoviedb.org 免费申请，用于文件整理刮削，留空则不刮削）
ENV_TMDB_API_KEY=
## 资源站登录 Cookie（详情页「资源」解锁用；从浏览器 F12 → Network → 任意请求的 Cookie 头整段复制，含 bbs_sid。留空则只能在面板里搜索，解锁需自行打开原帖）
ENV_PANFX_COOKIE=
## 解锁时是否自动回复帖子（1=自动回复解锁，0=只读检测不回复。站点机制是「回复后再查看」，不回帖就看不到隐藏链接）
ENV_PANFX_AUTO_REPLY=1
## 两次自动回复的最短间隔（秒，默认 30；调太小可能触发站点风控）
ENV_PANFX_REPLY_GAP=30
## 资源站地址（高级项，一般不用改。123分享社区，与 pan1.me 数据互通，哪个能通用哪个）
ENV_PANFX_BASE=https://www.123panfx.com
## 是否启用 AI 标题清洗（1=开启，0=关闭。仅当 TMDB 识别不到时才调用，会产生 API 费用）
ENV_AI_ENABLED=0
## AI API Key（OpenAI 兼容接口，DeepSeek 填 sk-xxx）
ENV_AI_API_KEY=
## AI 接口地址（OpenAI 兼容端点，换厂商填各自域名即可）
ENV_AI_BASE_URL=https://api.deepseek.com
## AI 模型名
ENV_AI_MODEL=deepseek-chat
## AI 每日调用上限（安全阀；按剧集部数计，整部剧只调一次）
ENV_AI_DAILY_QUOTA=50

# 资源转存
## 123分享链接转存的目标目录ID（在123网页中右键文件夹，选择复制文件夹ID获得）
ENV_123_LINK_UPLOAD_PID=0
## 123转存夸克分享的目标目录ID（同上）
ENV_123_KUAKE_UPLOAD_PID=0
## 123转存115网盘分享的目标目录ID（同上，无需登录115）
ENV_123_115_UPLOAD_PID=0
## 123离线磁力链接的目标目录ID（同上）
ENV_123_MAGNET_UPLOAD_PID=0
## JSON秒传的目标上传目录ID（同上）
ENV_123_JSON_UPLOAD_PID=0
## 监控转存目标目录ID（同上）
ENV_123_UPLOAD_PID=0
## 是否开启频道监控（1=开启，0=关闭）
ENV_AUTHORIZATION=0
## 监控的TG频道地址（多个用|分隔，如 https://t.me/s/cookie_gy）
ENV_TG_CHANNEL=https://t.me/s/cookie_gy
## 选择关键词（多个用|分隔，命中的内容会被转存，为空则会转存所有资源）
ENV_FILTER=PHJZ|123FSLink
## 排除关键词（多个用|分隔，命中的内容不会被转存，默认为空）
ENV_EXCLUDE_FILTER=
## 二次过滤关键词（格式：DV:1,DOLBY VISION:2，满足关键词转移到对应ID文件夹，否则到 ENV_123_UPLOAD_PID）
ENV_SECOND_FILTER=
## 检查新消息的时间间隔（分钟）
ENV_CHECK_INTERVAL=5
## 每秒保存文件数量（JSON秒传，默认5，建议≤10避免风控）
ENV_FILE_PER_SECOND=5
## 自定义分享提取码（生成分享链接时的密码，默认留空）
ENV_DIY_LINK_PWD=
## 是否自动生成JSON（1=生成，0=不生成，默认1）
ENV_AUTO_MAKE_JSON=1
## 创建分享链接时是否复用旧链接（1=复用，0=每次都创建新链接，默认1）
ENV_MAKE_NEW_LINK=1
